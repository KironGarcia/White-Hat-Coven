{
  "expo": {
    "name": "White Hat Coven",
    "slug": "whc-demo1",
    "scheme": "whc-demo1",
    "version": "0.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0716",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0716"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.whitehatcoven.demo1",
      "infoPlist": {
        "NSMotionUsageDescription": "O White Hat Coven usa o giroscópio para mover o mago."
      }
    },
    "android": {
      "package": "com.whitehatcoven.demo1",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "backgroundColor": "#301C41"
      },
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/PressStart2P-Regular.ttf"],
          "android": {
            "fonts": [
              {
                "fontFamily": "Press Start 2P",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PressStart2P-Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "O White Hat Coven usa o giroscópio para mover o mago."
        }
      ],
      "./plugins/with-audios-android"
    ],
    "owner": "argos.iotsec",
    "extra": {
      "eas": {
        "projectId": "92419142-bd71-4a6a-9568-cd7f48f68a84"
      }
    }
  }
}
